<Project>
  <!-- 未设置的命名空间先记成哨兵，项目文件里的空字符串会盖掉它。 -->
  <Import Project="$(MSBuildThisFileDirectory)AssemblyMeta.Namespace.props" Condition="'$(_AssemblyMetaNamespacePropsImported)' != 'true'" />
  <ItemGroup>
    <CompilerVisibleProperty Include="AssemblyMeta_ConstantsPayload" />
    <CompilerVisibleItemMetadata Include="Constant" MetadataName="Value" />
    <CompilerVisibleItemMetadata Include="Constant" MetadataName="Type" />
    <CompilerVisibleItemMetadata Include="Constant" MetadataName="Comment" />
    <CompilerVisibleItemMetadata Include="FileConstant" MetadataName="Value" />
    <CompilerVisibleItemMetadata Include="FileConstant" MetadataName="Link" />
    <CompilerVisibleItemMetadata Include="FileConstant" MetadataName="Comment" />

    <PackageReference Update="AssemblyMeta.Constants" PrivateAssets="all" />
    <PackageReference Update="AssemblyMeta" PrivateAssets="all" />
  </ItemGroup>
</Project>
