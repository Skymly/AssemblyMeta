<Project>
  <!-- 未设置的命名空间先记成哨兵，项目文件里的空字符串会盖掉它。 -->
  <Import Project="$(MSBuildThisFileDirectory)AssemblyMeta.Namespace.props" Condition="'$(_AssemblyMetaNamespacePropsImported)' != 'true'" />
  <ItemGroup>
    <CompilerVisibleProperty Include="AssemblyMeta_ResourcesPayload" />
    <CompilerVisibleItemMetadata Include="EmbeddedResource" MetadataName="ManifestResourceName" />
    <CompilerVisibleItemMetadata Include="EmbeddedResource" MetadataName="LogicalName" />
    <CompilerVisibleItemMetadata Include="EmbeddedResource" MetadataName="Link" />
    <CompilerVisibleItemMetadata Include="EmbeddedResource" MetadataName="Comment" />
    <CompilerVisibleItemMetadata Include="EmbeddedResource" MetadataName="AssemblyMetaResource" />

    <PackageReference Update="AssemblyMeta.Resources" PrivateAssets="all" />
    <PackageReference Update="AssemblyMeta" PrivateAssets="all" />
  </ItemGroup>
</Project>
