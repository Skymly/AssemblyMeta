<Project>
  <!-- 未设置的命名空间先记成哨兵，项目文件里的空字符串会盖掉它。 -->
  <Import Project="$(MSBuildThisFileDirectory)AssemblyMeta.Namespace.props" Condition="'$(_AssemblyMetaNamespacePropsImported)' != 'true'" />
  <ItemGroup>
    <CompilerVisibleProperty Include="AssemblyMeta_StringsPayload" />
    <CompilerVisibleItemMetadata Include="EmbeddedResource" MetadataName="WithCulture" />
    <CompilerVisibleItemMetadata Include="EmbeddedResource" MetadataName="Culture" />
    <CompilerVisibleItemMetadata Include="EmbeddedResource" MetadataName="Link" />
    <CompilerVisibleItemMetadata Include="EmbeddedResource" MetadataName="AssemblyMetaStrings" />

    <PackageReference Update="AssemblyMeta.Strings" PrivateAssets="all" />
    <PackageReference Update="AssemblyMeta" PrivateAssets="all" />
  </ItemGroup>
</Project>
