<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyMetaGeneratorProject>$(MSBuildThisFileDirectory)..\AssemblyMeta.Strings.Generator\AssemblyMeta.Strings.Generator.csproj</AssemblyMetaGeneratorProject>
    <AssemblyMetaGeneratorProjectDir>$(MSBuildThisFileDirectory)..\AssemblyMeta.Strings.Generator\</AssemblyMetaGeneratorProjectDir>
    <AssemblyMetaGeneratorAssembly>AssemblyMeta.Strings.Generator.dll</AssemblyMetaGeneratorAssembly>
    <AssemblyMetaBuildTransitiveDir>$(MSBuildThisFileDirectory)</AssemblyMetaBuildTransitiveDir>
    <AssemblyMetaPackageReadme>$(MSBuildThisFileDirectory)README.md</AssemblyMetaPackageReadme>
    <!-- resx 经 AdditionalFiles 直读，不需要 MSBuild 任务。 -->
    <AssemblyMetaIncludeTasks>false</AssemblyMetaIncludeTasks>
    <PackageId>AssemblyMeta.Strings</PackageId>
    <Description>Generates neutral .resx entries as AssemblyMeta.Strings compile-time string constants. / 把中性 resx 生成为 AssemblyMeta.Strings 编译期字符串常量。</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>roslyn;source-generator;resx;strings;constants;msbuild</PackageTags>
  </PropertyGroup>
  <Import Project="..\AssemblyMeta.Packaging.targets" />
</Project>
